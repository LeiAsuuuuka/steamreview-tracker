{
  "name": "server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "sync": "tsx scripts/sync-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "reindex": "tsx scripts/reindex.ts"
  },
  "dependencies": {
    "@node-rs/jieba": "^2.0.1",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  }
}
